# Server Environment Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Prisma ORM with Supabase PostgreSQL)
# DATABASE_URL uses the connection pooler (port 6543 with pgbouncer=true) for runtime queries
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:6543/postgres?pgbouncer=true"
# DIRECT_URL uses the direct database connection (port 5432) for Prisma migrations
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres"

# Supabase Storage Configuration (Media Assets)
# Find these in your Supabase Dashboard under Project Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_STORAGE_BUCKET=media

# JWT Authentication Configuration
JWT_SECRET=atelier_valenti_milano_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=atelier_valenti_milano_refresh_secret_key_2026_change_in_production
JWT_REFRESH_EXPIRES_IN=30d

# Frontend & Admin Client URLs (CORS)
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Upload Storage Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
