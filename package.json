{
  "name": "leathermart-server",
  "version": "1.0.0",
  "description": "Atelier Valenti Milano - Luxury Leather Outerwear Backend REST API (Supabase PostgreSQL)",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "build": "prisma generate",
    "postinstall": "prisma generate",
    "start": "node src/server.js",
    "start:local": "node --env-file=.env.local src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "dev:local": "node --env-file=.env.local --watch src/server.js",
    "seed": "node src/scripts/seed.js",
    "seed:reset": "node src/scripts/seed.js --reset",
    "test": "vitest run --test-timeout=30000",
    "db:test": "node --env-file=.env src/scripts/test-db-connection.js",
    "db:test:local": "node --env-file=.env.local src/scripts/test-db-connection.js",
    "prisma:generate": "node --env-file=.env node_modules/prisma/build/index.js generate",
    "prisma:generate:local": "node --env-file=.env.local node_modules/prisma/build/index.js generate",
    "prisma:migrate:local": "node --env-file=.env.local node_modules/prisma/build/index.js migrate dev",
    "prisma:studio": "node --env-file=.env node_modules/prisma/build/index.js studio",
    "prisma:studio:local": "node --env-file=.env.local node_modules/prisma/build/index.js studio",
    "bootstrap:admin": "node src/scripts/bootstrap-admin.js"
  },
  "pre-commit": [
    "build",
    "add-build"
  ],
  "keywords": [
    "express",
    "supabase",
    "postgresql",
    "rest-api",
    "luxury-ecommerce",
    "atelier-valenti"
  ],
  "author": "Atelier Valenti Milano",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.49.1",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "prisma": "^6.19.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "vitest": "^3.0.8"
  }
}